{
  "$schema": "https://mintlify.com/docs.json",
  "theme": "mint",
  "name": "Mint Starter Kit",
  "colors": {
    "primary": "#021a4f",
    "light": "#638fee",
    "dark": "#000d27"
  },
  "favicon": "/favicon.svg",
  "navigation": {
    "tabs": [
      {
        "tab": "Vendors",
        "groups": [
          {
            "group": "Start here",
            "pages": ["vendors/why", "vendors/how"]
          },
          {
            "group": "Create product listings",
            "pages": [
              "vendors/create-single-product",
              "vendors/import-bulk-products"
            ]
          },
          {
            "group": "Manage your inventory",
            "pages": ["vendors/card-view", "vendors/catalogue-view"]
          }
        ]
      }
    ],
    "global": {}
  },
  "logo": {
    "light": "/logo/light.png",
    "dark": "/logo/dark.png",
    "link": "https://ship-around.com/shop"
  },
  "navbar": {
