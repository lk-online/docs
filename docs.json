            "pages": [
              "platform/categories-and-coverage",
              "platform/trust-payments-support"
            ]
          }
        ]
      },
      {
        "tab": "Product pages",
        "groups": [
          {
            "group": "Overview",
            "pages": [
              "product-pages/overview",
              "product-pages/leaf-category-pages",
              "product-pages/single-product-pages"
            ]
          }
        ]
      },
      {
        "tab": "Buyers",
        "groups": [
          {
            "group": "Start here",
            "pages": ["buyers/why", "buyers/how"]
